# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=manyboost
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SendGrid (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# App
APP_NAME=ManyBoost
APP_URL=http://localhost:3000

# Tremendous Gift Card API
# Sandbox: https://testflight.tremendous.com  |  Production: https://api.tremendous.com
TREMENDOUS_API_KEY=
TREMENDOUS_SANDBOX=true
TREMENDOUS_FUNDING_SOURCE_ID=balance

# Economy (overrides defaults)
POINTS_PER_MINUTE=1
POINT_CAP=1000
SPIN_INTERVAL_MINUTES=30
MAX_SPINS=4
